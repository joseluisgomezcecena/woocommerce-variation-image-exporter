# =============================================================================
# WC variant images extractor — env config
# =============================================================================
# Copy this file to `.env` and fill in your values.

# Your WordPress site URL (no trailing slash)
WP_SITE_URL=https://montereycompany.com

# WooCommerce REST API credentials (Read permission is enough)
# Get them: WP Admin -> WooCommerce -> Settings -> Advanced -> REST API -> Add key
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional tuning
PER_PAGE=100
REQUEST_DELAY_MS=120
OUTPUT_FILE=./variant-images.csv
VERBOSE=0

# If set to 1, the CSV also includes one row per parent product gallery image
# (with an empty variant_sku). Useful if you also want to capture product-level
# images via this script. Default: 0 (variant images only).
INCLUDE_PARENT_GALLERY=0
